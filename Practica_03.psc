Algoritmo Practica_3
	//Ralize un programa que permita usar dos numeros
	//para realizar las 4 operaciones al mismo tiempo
		
		//Definir 
		Definir numero1 Como Entero
		Definir numero2 Como Entero
		Definir suma, resta ,multiplicar, dividir Como Entero
		//Entrada
		Escribir "Ingrese el primer numero"
		Leer numero1
		Escribir"Ingrese el segundo numero "
		Leer numero2
		//Proceso
		suma=numero1+numero2
		resta=numero1-numero2
		multiplicar=numero1*numero2
		dividir=numero1/numero2
		//Salida
		Escribir "la suma de dos numero es: " suma
		Escribir "la resta de dos numeros es: " resta 
		Escribir "la multiplicacion de dos numero es: " multiplicar
		Escribir "la division de dos numeros es: " dividir
	
FinAlgoritmo
